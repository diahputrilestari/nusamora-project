# Alamat bersih tanpa .html (mis. /live/jawa-tengah) di Apache/Hostinger
RewriteEngine On
# ---- PERLINDUNGAN SERVER: repo ini dideploy apa adanya ke web root, jadi folder internal TIDAK boleh bisa diunduh.
# (skema SQL, tes, dokumen keamanan, sumber builder, kode Edge Function, aplikasi Next.js, metadata git/CI).
RewriteRule ^(backend|ops|docs|builder|source|supabase|next|\.git|\.github)(/|$) - [F,L,NC]
RewriteRule ^(README\.md|vercel\.json|package(-lock)?\.json|.*\.(sql|md|py|mjs|ts|toml|ya?ml|lock|env|log|bak|orig|swp|map))$ - [F,L,NC]
# robots.txt dan sitemap.xml tetap publik (bukan pola di atas). Direktori tanpa index.html tidak boleh didaftar (mis. /assets/).
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [F,L]

# Hapus .html dari URL yang diketik
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Sajikan file .html jika ada
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # HSTS hanya dikirim lewat HTTPS. Mulai konservatif (1 minggu, tanpa includeSubDomains/preload);
  # naikkan bertahap setelah semua subdomain terbukti HTTPS (lihat docs/security/SECURITY-HEADERS.md).
  Header always set Strict-Transport-Security "max-age=604800" "expr=%{HTTPS} == 'on'"
  # CSP MODE REPORT-ONLY: hanya melaporkan pelanggaran, TIDAK memblokir. Jadikan "Content-Security-Policy"
  # setelah laporan bersih (docs/security/SECURITY-HEADERS.md). 'unsafe-inline' dibutuhkan halaman lama
  # (skrip inline Live Guest & atribut style) dan dihapus saat halaman dipindah ke Next.js (nonce).
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://app.midtrans.com https://app.sandbox.midtrans.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.midtrans.com https://api.sandbox.midtrans.com; frame-src https://app.midtrans.com https://app.sandbox.midtrans.com https://maps.google.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  <FilesMatch "\.(webp|png|svg|mp3)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

AddType audio/mpeg .mp3
AddType image/webp .webp
