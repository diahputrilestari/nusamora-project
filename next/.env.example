# Salin ke .env.local (pengembangan) atau isi di dashboard Node.js Hostinger (produksi). JANGAN commit nilai asli.
# Kunci publishable/anon aman untuk browser (dilindungi RLS). Jangan pernah menaruh service_role key atau Midtrans Server Key di sini.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Alamat situs untuk canonical/hreflang/sitemap (tanpa garis miring akhir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CSP: "report-only" (default, tidak memblokir) atau "enforce" setelah laporan bersih
CSP_MODE=report-only
