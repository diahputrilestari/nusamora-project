{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/invite/themes/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets-signature/(.*).glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets-signature/invite/index",
      "destination": "/assets-signature/invite/index.html"
    },
    {
      "source": "/(artikel|bantuan|tutorial)",
      "destination": "/konten.html"
    },
    {
      "source": "/(artikel|info)/:slug",
      "destination": "/konten.html"
    },
    {
      "source": "/(backend|ops|docs|builder|source|supabase|next|\\.github)/:path*",
      "destination": "/404"
    },
    {
      "source": "/(README\\.md|vercel\\.json|.*\\.(sql|md|py|mjs|ts|toml|ya?ml|map))",
      "destination": "/404"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "destination": "/undangan"
    }
  ]
}
